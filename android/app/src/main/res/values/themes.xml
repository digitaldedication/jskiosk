<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JsKiosk" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/kiosk_blue</item>
        <item name="android:statusBarColor">@color/kiosk_blue_dark</item>
        <item name="android:navigationBarColor">@color/kiosk_blue_dark</item>
    </style>

    <style name="Theme.JsKiosk.Fullscreen" parent="Theme.JsKiosk">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
